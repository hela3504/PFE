# ═══════════════════════════════════════════════════════════════════════════
#  SEO BI — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs.
# ═══════════════════════════════════════════════════════════════════════════

# ── Base de données ─────────────────────────────────────────────────────────
# Chaîne de connexion PostgreSQL. SSL automatique pour les hosts non-locaux.
# Exemple Neon : postgresql://user:pass@host.neon.tech/db?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# ── Sécurité ────────────────────────────────────────────────────────────────
# Secret de signature des tokens JWT — utiliser une chaîne aléatoire ≥ 32 chars
# Générer par exemple avec : openssl rand -hex 32
JWT_SECRET=remplacer-par-un-secret-aleatoire-de-32-caracteres-minimum

# ── Z.AI (LLM) ──────────────────────────────────────────────────────────────
# Clé API Z.AI obtenue sur https://z.ai — format {32hex}.{16alphanum}
ZHIPU_API_KEY=

# ── n8n (workflows de collecte) ─────────────────────────────────────────────
# Clé partagée entre l'app et les workflows n8n (header x-api-key)
API_KEY_N8N=remplacer-par-une-cle-aleatoire

# URL de base de l'instance n8n
N8N_BASE_URL=https://n8n.exemple.com

# Webhooks dédiés (URL fournies par l'admin n8n)
N8N_RESET_WEBHOOK_URL=https://n8n.exemple.com/webhook/reset-collecte
N8N_REFRESH_GSC_WEBHOOK_URL=https://n8n.exemple.com/webhook/refresh-gsc-keyword

# ── Application ─────────────────────────────────────────────────────────────
# URL publique du frontend (utilisée dans les liens d'email de reset password)
APP_URL=http://localhost:3000

# Port d'écoute du serveur Node (par défaut 3000)
PORT=3000

# ── SMTP (envoi d'emails de réinitialisation) ───────────────────────────────
# Pour Gmail : utiliser un App Password (pas le mot de passe normal)
# Voir https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SEO BI <noreply@exemple.com>

# ── Bootstrap admin ─────────────────────────────────────────────────────────
# Au boot, l'app promeut ce compte en administrateur s'il existe déjà en base.
# Workflow : 1) signup via l'UI avec cet email, 2) restart serveur.
# L'app ne crée jamais le compte automatiquement (sécurité).
BOOTSTRAP_ADMIN_EMAIL=

# ── Documentation API (Swagger) ─────────────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_TITLE=SEO BI API
SWAGGER_DESCRIPTION=API REST de l'application SEO Business Intelligence
SWAGGER_VERSION=1.0.0
SWAGGER_ROUTE=/api-docs
SWAGGER_SERVER_URL=http://localhost:3000
